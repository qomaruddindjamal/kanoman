# Kanoman AI — Environment Configuration Template
# DO NOT COMMIT REAL SECRETS IN THIS FILE OR REPOSITORY

# Environment (development, staging, production, test)
KANOMAN_ENV=development

# Workspace & Storage Configuration
KANOMAN_WORKSPACE_ROOT=C:\kanoman
KANOMAN_CHECKPOINT_DIR=C:\kanoman\.kanoman_checkpoints

# Git Controller Policies
KANOMAN_GIT_DRY_RUN=true
KANOMAN_GIT_ALLOWED_REMOTE=https://github.com/qomaruddindjamal/kanoman.git
KANOMAN_GIT_ALLOWED_BRANCHES=main,develop

# AI Provider Configuration
# Supported providers: mock, gemini, ollama
KANOMAN_DEFAULT_AI_PROVIDER=mock
KANOMAN_AI_TIMEOUT_SECONDS=30
KANOMAN_AI_MAX_RETRIES=2

# Secrets (Leave empty for mock/offline testing; supply via local .env or CI secret)
# GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
